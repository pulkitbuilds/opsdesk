# Neon / Vercel Postgres connection string (Vercel's Neon integration sets DATABASE_URL or POSTGRES_URL)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string
# Password given to demo accounts when the database is first seeded
DEMO_PASSWORD=change-me-too
